# Only Proxmox may push. Query/admin APIs remain on the Compose network and loopback.
server {
    listen 3100;
    server_tokens off;
    client_max_body_size 8m;
    location = /loki/api/v1/push {
        allow PROXMOX_IP;
        deny all;
        limit_except POST { deny all; }
        proxy_pass http://loki:3100;
        proxy_read_timeout 60s;
    }
    location / { return 403; }
}
