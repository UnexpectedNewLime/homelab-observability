# Copy to .env on the deployment host. Never commit filled-in values.
MONITORING_IP=
PROXMOX_IP=
NEXTCLOUD_CT_IP=
DISCORD_VM_IP=
NEXTCLOUD_URL=
DISCORD_VM_ID=
NEXTCLOUD_CT_ID=
PVE_TOKEN_VALUE=

# Additional .example template inputs. IPv4 addresses are required above.
WATCHER_HOST_LABEL=
NEXTCLOUD_JOURNAL_PATH=
NTFY_BASE_URL=
# Absolute path on watcher; also accepted by credential/acceptance scripts.
# Default for those scripts alone: ~/.config/homelab-alerting
NTFY_CREDENTIALS_DIR=
