        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "definition": "label_values(up{job=~\"blackbox_.*\"}, instance)",
        "hide": 0,
        "includeAll": true,
        "label": "Endpoint",
        "multi": true,
        "name": "endpoint",
        "options": [],
        "query": "label_values(up{job=~\"blackbox_.*\"}, instance)",
        "refresh": 1,
        "skipUrlSync": false,
        "sort": 1,
