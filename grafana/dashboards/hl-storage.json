          "editorMode": "code",
          "expr": "100 * (1 - node_filesystem_avail_bytes{role=\"host\",service=~\"$host\",fstype!~\"tmpfs|overlay|squashfs|proc|sysfs|devtmpfs\",mountpoint!~\"/run.*|/var/lib/docker.*|/var/lib/lxcfs|/etc/pve\"}/node_filesystem_size_bytes{role=\"host\",service=~\"$host\",fstype!~\"tmpfs|overlay|squashfs|proc|sysfs|devtmpfs\",mountpoint!~\"/run.*|/var/lib/docker.*|/var/lib/lxcfs|/etc/pve\"})",
          "instant": true,
          "legendFormat": "{{service}} · {{mountpoint}}",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Filesystem / dataset utilisation",
      "type": "bargauge"
    },
