  ],
  "templating": {
    "list": [
      {
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "definition": "label_values(up{job=\"node\",role=\"host\"}, service)",
        "hide": 0,
        "includeAll": true,
        "label": "Physical host",
        "multi": true,
        "name": "host",
        "options": [],
        "query": "label_values(up{job=\"node\",role=\"host\"}, service)",
        "refresh": 1,
        "skipUrlSync": false,
        "sort": 1,
        "type": "query"
