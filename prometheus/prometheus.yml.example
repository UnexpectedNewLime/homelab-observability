global:
  scrape_interval: 15s
  evaluation_interval: 15s

alerting:
  alertmanagers:
    - static_configs:
        - targets:
            - alertmanager:9093

rule_files:
  - /etc/prometheus/rules/*.yml

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets:
          - prometheus:9090
        labels:
          service: prometheus
          role: monitoring

  - job_name: node
    static_configs:
      - targets:
          - MONITORING_IP:9100
        labels:
          service: monitoring-host
          role: host

      - targets:
          - PROXMOX_IP:9100
        labels:
          service: proxmox
          role: host

      - targets:
          - NEXTCLOUD_CT_IP:9100
        labels:
          service: nextcloud
          role: lxc

      - targets:
          - DISCORD_VM_IP:9100
        labels:
          service: discord-bot
          role: vm

  - job_name: pve
    metrics_path: /pve
    params:
      module: [default]
      cluster: ["1"]
      node: ["1"]
    static_configs:
      - targets:
          - PROXMOX_IP
        labels:
          service: proxmox
          role: pve-api
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: instance
      - target_label: __address__
        replacement: pve-exporter:9221

  - job_name: blackbox_icmp
    metrics_path: /probe
    params:
      module: [icmp]
    static_configs:
      - targets:
          - PROXMOX_IP
          - NEXTCLOUD_CT_IP
          - DISCORD_VM_IP
        labels:
          check_type: icmp
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: instance
      - target_label: __address__
        replacement: blackbox:9115

  - job_name: blackbox_http
    metrics_path: /probe
    params:
      module: [http_insecure_2xx]
    static_configs:
      - targets:
          - https://PROXMOX_IP:8006/
        labels:
          service: proxmox
          check_type: http
          endpoint: pve-web

      - targets:
          - https://NEXTCLOUD_URL/status.php
        labels:
          service: nextcloud
          check_type: http
          endpoint: nextcloud-status

      - targets:
          - http://DISCORD_VM_IP:8080/healthz
        labels:
          service: discord-bot
          check_type: http
          endpoint: bot-healthz

    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: instance
      - target_label: __address__
        replacement: blackbox:9115