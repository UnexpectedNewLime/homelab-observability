logging {
  level = "info"
}
loki.write "watcher" {
  endpoint {
    url = "http://MONITORING_IP:3100/loki/api/v1/push"
    max_backoff_retries = 0
  }
  wal {
    enabled = true
    max_segment_age = "24h"
  }
}
discovery.relabel "journal" {
  targets = []
  rule {
    target_label = "service"
    replacement = "system"
  }
  rule {
    source_labels = ["__journal__systemd_unit"]
    regex = "(.+[.]service)"
    target_label = "service"
  }
  rule {
    source_labels = ["__journal__systemd_unit"]
    regex = "(.+[.]service)"
    target_label = "unit"
  }
  rule {
    source_labels = ["__journal__transport"]
    regex = "kernel"
    target_label = "service"
    replacement = "kernel"
  }
  rule {
    source_labels = ["__journal_syslog_identifier"]
    regex = "homelab-log-heartbeat"
    target_label = "service"
    replacement = "homelab-log-heartbeat"
  }
  rule {
    source_labels = ["__journal_priority_keyword"]
    target_label = "level"
  }
  rule {
    source_labels = ["service"]
    regex = "(.+)@.+[.]service"
    target_label = "service"
    replacement = "$1@.service"
  }
  rule {
    source_labels = ["service"]
    regex = "run-.+[.]service"
    target_label = "service"
    replacement = "transient.service"
  }
  rule {
    source_labels = ["service"]
    target_label = "unit"
  }
}
loki.source.journal "host" {
  max_age = "12h"
  labels = {host = "pve", ct = "host"}
  relabel_rules = discovery.relabel.journal.rules
  forward_to = [loki.write.watcher.receiver]
}
loki.source.journal "ctNEXTCLOUD_CT_ID" {
  path = "NEXTCLOUD_JOURNAL_PATH"
  max_age = "12h"
  labels = {host = "pve", ct = "NEXTCLOUD_CT_ID"}
  relabel_rules = discovery.relabel.journal.rules
  forward_to = [loki.write.watcher.receiver]
}
loki.source.file "pve_tasks" {
  targets = [{__path__ = "/var/log/pve/tasks/index", host = "pve", ct = "host", service = "pve-tasks"}]
  tail_from_end = true
  forward_to = [loki.write.watcher.receiver]
}
